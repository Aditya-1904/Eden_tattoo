# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Public URL of the live site (used for SEO, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://edentattoos.com

# Booking enquiries by email (https://resend.com — free tier is plenty).
# Without RESEND_API_KEY the form still works: it hands the enquiry to WhatsApp instead.
RESEND_API_KEY=
# Where enquiries are delivered (comma-separate several addresses)
ENQUIRY_TO_EMAIL=chd.edentattoos@gmail.com
# Sender. Must be on a domain verified in Resend; onboarding@resend.dev works for testing
# but can only deliver to the email address that owns the Resend account.
ENQUIRY_FROM_EMAIL=Eden Tattoos Website <onboarding@resend.dev>
